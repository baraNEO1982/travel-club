{
  "name": "travel-club",
  "main": "worker/club.ts",
  "account_id": "9543f0fe33dc3b97a112fff19c091684",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-club",
      "database_id": "843cdabd-48e4-48a6-bd17-397549b902d3",
      "migrations_dir": "database/club"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "11b733c7347f4e3c996ef67d960a9514"
    }
  ],
  "preview_urls": false
}
